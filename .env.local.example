# ─────────────────────────────────────────────────────────────────
# Airtable CMS — copy this file to .env.local and fill in values
# Leave both empty to use the built-in local data as fallback
# ─────────────────────────────────────────────────────────────────

# Your Airtable Personal Access Token
# → airtable.com → your avatar → Developer hub → Personal access tokens → Create token
# Required scope: data.records:read
AIRTABLE_PAT=

# Your Airtable Base ID (starts with "app")
# → Open your base → Help → API documentation → look for "The ID of this base is appXXXXXXX"
AIRTABLE_BASE_ID=
